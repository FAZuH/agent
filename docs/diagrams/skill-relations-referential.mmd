---
config:
  theme: 'neutral'
---
flowchart TD
    subgraph loaders_orch["Orchestration"]
        worktree_new_r["worktree-new"]
        worktree_finish_r["worktree-finish"]
        worktree_close_r["worktree-close"]
    end
    subgraph loaders_workflow["Workflow"]
        finish_r["finish"]
        session_r["session"]
        prepare_compact_r["prepare-compact"]
        scratch_finish_r["scratch-finish"]
        task_context_r["task-context"]
    end
    subgraph refdeps["Referential"]
        scratch["scratch"]
        worktree["worktree"]
    end

    %% following-procedures (14 loaders) and gate (12 loaders) omitted:
    %% every procedural skill loads them, so the edges add no signal.
    %% Full edge list lives in the skill-doctor graph.mmd.

    worktree_new_r --> worktree
    worktree_finish_r --> worktree
    worktree_close_r --> worktree

    finish_r --> scratch
    session_r --> scratch
    prepare_compact_r --> scratch
    scratch_finish_r --> scratch
    task_context_r --> scratch
    worktree --> scratch
    scratch --> scratch_finish_r

    subgraph legend["Legend"]
        direction LR
        L_orch["Orchestration"]
        L_work["Workflow"]
        L_ref["Referential"]
    end

    classDef orchestration fill:#DE7A63,stroke:#BE5D48,color:#FFFFFF
    classDef workflow fill:#F2D077,stroke:#D1AD54,color:#3A2E14
    classDef referential fill:#9DBB98,stroke:#7B9C76,color:#FFFFFF

    class L_ref,scratch,worktree referential
    class L_orch,worktree_new_r,worktree_finish_r,worktree_close_r orchestration
    class L_work,finish_r,session_r,prepare_compact_r,scratch_finish_r,task_context_r workflow
