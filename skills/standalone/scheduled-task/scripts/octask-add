#!/usr/bin/env bash
# octask-add — add a managed systemd user timer/service pair (octask-<name>)
#
# Usage:
#   octask-add <name> --exec "<command>" [--oncalendar "<expr>"]
#              [--description "..."] [--workdir <dir>] [--timeout <sec>]
#              [--env "KEY=VALUE"] [--delay "<span>"] [--persistent]
#              [--no-enable] [--force]
#
# Creates ~/.config/systemd/user/octask-<name>.{service,timer}.
# List/remove managed units with octask-list / octask-remove.
set -euo pipefail

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PREFIX="octask-"

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; die "missing arguments"; }
die() { echo "octask-add: $*" >&2; exit 1; }

# single-quote a string for systemd ExecStart (no $ expansion inside)
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

name="" oncalendar="" exec_cmd="" description="" workdir="" timeout=""
delay="" persistent=0 no_enable=0 force=0
envs=()

while [ $# -gt 0 ]; do
  case "$1" in
    --oncalendar)  oncalendar="$2"; shift 2 ;;
    --exec)        exec_cmd="$2"; shift 2 ;;
    --description) description="$2"; shift 2 ;;
    --workdir)     workdir="$2"; shift 2 ;;
    --timeout)     timeout="$2"; shift 2 ;;
    --env)         envs+=("$2"); shift 2 ;;
    --delay)       delay="$2"; shift 2 ;;
    --persistent)  persistent=1; shift ;;
    --no-enable)   no_enable=1; shift ;;
    --force)       force=1; shift ;;
    -h|--help)     sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)            die "unknown option: $1" ;;
    *)             [ -z "$name" ] || die "unexpected argument: $1"; name="$1"; shift ;;
  esac
done

[ -n "$name" ] || usage
[ -n "$exec_cmd" ] || die "--exec is required"
[ -n "$oncalendar" ] || oncalendar="*-*-* 00/12:00:00"
[ -n "$description" ] || description="$PREFIX$name job"

# validate name
printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]*$' || die "invalid name '$name' (use [a-z0-9][a-z0-9_-]*)"

# validate schedule BEFORE writing anything
if ! systemd-analyze calendar "$oncalendar" >/dev/null 2>&1; then
  systemd-analyze calendar "$oncalendar" 2>&1 | head -3 >&2 || true
  die "invalid OnCalendar expression: $oncalendar"
fi

# validate optional extras
if [ -n "$workdir" ] && [ ! -d "$workdir" ]; then die "--workdir does not exist: $workdir"; fi
if [ -n "$timeout" ] && ! printf '%s' "$timeout" | grep -Eq '^[0-9]+$'; then die "--timeout must be seconds"; fi
if [ -n "$delay" ] && ! systemd-analyze timespan "$delay" >/dev/null 2>&1; then
  die "invalid --delay timespan: $delay"
fi

base="$UNIT_DIR/$PREFIX$name"
for f in "$base.service" "$base.timer"; do
  if [ -e "$f" ] && [ "$force" -ne 1 ]; then
    die "$f already exists (use --force to overwrite)"
  fi
done

mkdir -p "$UNIT_DIR"

# --- service ---
{
  echo "[Unit]"
  echo "Description=$description"
  echo ""
  echo "[Service]"
  echo "Type=oneshot"
  [ -n "$workdir" ] && echo "WorkingDirectory=$workdir"
  for e in "${envs[@]+"${envs[@]}"}"; do echo "Environment=$e"; done
  [ -n "$timeout" ] && echo "TimeoutStartSec=$timeout"
  echo "ExecStart=/usr/bin/bash -c $(sq "$exec_cmd")"
} > "$base.service"

# --- timer ---
{
  echo "[Unit]"
  echo "Description=$description (timer)"
  echo ""
  echo "[Timer]"
  echo "OnCalendar=$oncalendar"
  [ -n "$delay" ] && echo "RandomizedDelaySec=$delay"
  [ "$persistent" -eq 1 ] && echo "Persistent=true"
  echo ""
  echo "[Install]"
  echo "WantedBy=timers.target"
} > "$base.timer"

systemctl --user daemon-reload

if [ "$no_enable" -eq 1 ]; then
  echo "added $PREFIX$name (not enabled): $base.{service,timer}"
  echo "enable later: systemctl --user enable --now $PREFIX$name.timer"
  exit 0
fi

systemctl --user enable --now "$PREFIX$name.timer" >/dev/null

next="$(systemctl --user show "$PREFIX$name.timer" --property=NextElapseUSecRealtime --value 2>/dev/null)"
echo "added $PREFIX$name: $base.{service,timer}"
echo "  schedule: OnCalendar=$oncalendar${delay:+ (delay up to $delay)}$([ "$persistent" -eq 1 ] && echo -n ', persistent')"
[ -n "$workdir" ] && echo "  workdir:  $workdir"
echo "  next run: ${next:-unknown} (systemctl --user list-timers '$PREFIX*')"
