#!/usr/bin/env bash
# octask-remove — remove a managed octask-<name> timer/service pair
#
# Usage:
#   octask-remove <name> [--dry-run]
set -euo pipefail

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PREFIX="octask-"
dry_run=0
name=""

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1; shift ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)        echo "octask-remove: unknown option: $1" >&2; exit 1 ;;
    *)         [ -z "$name" ] || { echo "octask-remove: unexpected argument: $1" >&2; exit 1; }; name="$1"; shift ;;
  esac
done

[ -n "$name" ] || { sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
printf '%s' "$name" | grep -Eq '^[a-z0-9][a-z0-9_-]*$' || { echo "octask-remove: invalid name '$name'" >&2; exit 1; }

base="$UNIT_DIR/$PREFIX$name"
units=("$base.timer" "$base.service")
found=0
for f in "${units[@]}"; do [ -e "$f" ] && found=1; done

if [ "$found" -eq 0 ]; then
  echo "octask-remove: no units found for '$PREFIX$name' (nothing to do)"
  exit 0
fi

if [ "$dry_run" -eq 1 ]; then
  echo "dry-run: would stop+disable $PREFIX$name.timer, delete:"
  for f in "${units[@]}"; do [ -e "$f" ] && echo "  $f"; done
  exit 0
fi

systemctl --user stop "$PREFIX$name.timer" 2>/dev/null || true
systemctl --user disable "$PREFIX$name.timer" 2>/dev/null || true
for f in "${units[@]}"; do [ -e "$f" ] && rm -f "$f"; done
systemctl --user daemon-reload
systemctl --user reset-failed "$PREFIX$name.timer" "$PREFIX$name.service" 2>/dev/null || true

echo "removed $PREFIX$name ({timer,service})"
