#!/usr/bin/env bash
# octask-list — list managed octask-* timers and unit files
#
# Usage:
#   octask-list
set -euo pipefail

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PREFIX="octask-"

echo "== managed timers ($PREFIX*) =="
systemctl --user list-timers "$PREFIX*" --all --no-pager 2>/dev/null || true

echo ""
echo "== managed unit files =="
found=0
for f in "$UNIT_DIR"/"$PREFIX"*".timer" "$UNIT_DIR"/"$PREFIX"*".service"; do
  [ -e "$f" ] || continue
  found=1
  echo "  $f"
done
if [ "$found" -eq 0 ]; then
  echo "  (none — nothing managed by octask yet)"
fi
