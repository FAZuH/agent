#!/usr/bin/env bash
# octask — unified CLI for managed octask-* systemd user timers
#
# Usage:
#   octask add <name> --exec "<cmd>" [--oncalendar "<expr>"]
#              [--description "..."] [--workdir <dir>] [--timeout <sec>]
#              [--env "KEY=VALUE"] [--credential NAME:PATH] [--delay "<span>"]
#              [--persistent] [--no-enable] [--force]
#   octask add <name> --agent <agent-id> --prompt "<text>" --workdir <dir>
#              [--model <provider/model>] [--oncalendar "<expr>"]
#              [--description "..."] [--persistent] [--dirty-only]
#              [--credential NAME:PATH] [--timeout <sec>] [--delay "<span>"]
#              [--no-enable] [--force]
#   octask edit <name> [--model <p/m> | --no-model] [--prompt "<text>"]
#              [--agent <id>] [--oncalendar "<expr>"] [--description "..."]
#              [--workdir <dir>] [--timeout <sec>]
#              [--delay "<span>" | --no-delay] [--persistent | --no-persistent]
#              [--credential NAME:PATH] [--clear-credentials] [--dry-run]
#   octask show <name>
#   octask remove <name> [--dry-run]
#   octask list
#   octask export [name ...] [--file <path>]
#   octask import [--file <path>] [--force] [--no-enable]
#   octask enable <name> | disable <name>
#   octask status <name> | logs <name> [-n <lines>]
#
# Manages ~/.config/systemd/user/octask-<name>.{service,timer}.
# `add --agent` schedules unattended `opencode run --agent <id>` runs and
# prefers the v2 beta binary (~/.opencode/bin/opencode2).
set -euo pipefail

PREFIX="octask-"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

die() { echo "octask: $*" >&2; exit 1; }
usage() { sed -n '2,27p' "$0" | sed 's/^# \{0,1\}//'; }

# single-quote a string for systemd ExecStart (no $ expansion inside)
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# double-quote a string for the inner bash (used for agent prompts); the
# result is later single-quoted for systemd by sq(), which converts any
# literal ' to '\'' — the two together keep apostrophes balanced
bq() {
  # shellcheck disable=SC2016  # sed patterns intentionally use literal $
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\$/\\$/g' -e 's/`/\\`/g')"
}

# inverse of bq(): undo the inner-bash escaping (reverse order of bq so an
# original backslash-quote restores correctly)
unbq() {
  printf '%s' "$1" | sed -e 's/\\`/`/g' -e 's/\\\$/$/g' -e 's/\\"/"/g' -e 's/\\\\/\\/g'
}

valid_name() {
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9_-]*$'
}

require_name() {
  [ -n "${1:-}" ] || { usage; die "missing <name>"; }
  valid_name "$1" || die "invalid name '$1' (use [a-z0-9][a-z0-9_-]*)"
}

units_exist() {
  [ -e "$UNIT_DIR/$PREFIX$1.service" ] || [ -e "$UNIT_DIR/$PREFIX$1.timer" ]
}

# Accept the bare <name> or a full unit name: octask-<name>[.timer|.service]
norm_name() {
  local n="$1"
  n="${n%.timer}"; n="${n%.service}"
  printf '%s' "${n#"$PREFIX"}"
}

# ---------------------------------------------------------------- add ----
cmd_add() {
  local name="" oncalendar="" exec_cmd="" description="" workdir="" timeout=""
  local delay="" persistent=0 no_enable=0 force=0 dirty_only=0
  local agent_id="" prompt="" model=""
  local -a envs=() creds=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --exec)        exec_cmd="$2"; shift 2 ;;
      --agent)       agent_id="$2"; shift 2 ;;
      --prompt)      prompt="$2"; shift 2 ;;
      --model)       model="$2"; shift 2 ;;
      --dirty-only)  dirty_only=1; shift ;;
      --oncalendar)  oncalendar="$2"; shift 2 ;;
      --description) description="$2"; shift 2 ;;
      --workdir)     workdir="$2"; shift 2 ;;
      --timeout)     timeout="$2"; shift 2 ;;
      --env)         envs+=("$2"); shift 2 ;;
      --credential)  creds+=("$2"); shift 2 ;;
      --delay)       delay="$2"; shift 2 ;;
      --persistent)  persistent=1; shift ;;
      --no-enable)   no_enable=1; shift ;;
      --force)       force=1; shift ;;
      -h|--help)     usage; exit 0 ;;
      -*)            die "add: unknown option: $1" ;;
      *)             [ -z "$name" ] || die "add: unexpected argument: $1"; name="$1"; shift ;;
    esac
  done

  name="$(norm_name "$name")"
  require_name "$name"

  # ---- mode dispatch -------------------------------------------------
  local is_agent=0
  if [ -n "$agent_id" ] || [ -n "$prompt" ]; then
    is_agent=1
    [ -n "$agent_id" ] || die "add: --agent is required with --prompt"
    [ -n "$prompt" ]   || die "add: --prompt is required with --agent"
    [ -n "$workdir" ]  || die "add: --workdir is required for agent runs"
    [ -z "$exec_cmd" ] || die "add: --exec cannot be combined with --agent/--prompt"
  else
    [ -n "$exec_cmd" ] || die "add: --exec is required (or use --agent/--prompt)"
  fi

  [ -n "$oncalendar" ] || oncalendar="*-*-* 00/12:00:00"

  # ---- validation BEFORE writing anything -----------------------------
  if ! systemd-analyze calendar "$oncalendar" >/dev/null 2>&1; then
    systemd-analyze calendar "$oncalendar" 2>&1 | head -3 >&2 || true
    die "add: invalid OnCalendar expression: $oncalendar"
  fi
  [ -z "$workdir" ] || [ -d "$workdir" ] || die "add: --workdir does not exist: $workdir"
  [ -z "$timeout" ] || printf '%s' "$timeout" | grep -Eq '^[0-9]+$' || die "add: --timeout must be seconds"
  if [ -n "$delay" ] && ! systemd-analyze timespan "$delay" >/dev/null 2>&1; then
    die "add: invalid --delay timespan: $delay"
  fi
  local c cname cpath
  for c in ${creds[@]+"${creds[@]}"}; do
    case "$c" in *:*) ;;
      *) die "add: --credential must be NAME:PATH, got: $c" ;;
    esac
    cname="${c%%:*}"; cpath="${c#*:}"
    printf '%s' "$cname" | grep -Eq '^[A-Za-z0-9_.-]+$' \
      || die "add: bad credential name '$cname' (use [A-Za-z0-9_.-])"
    [ -e "$cpath" ] || die "add: credential source does not exist: $cpath"
  done

  # ---- agent-mode pre-flights -----------------------------------------
  local oc_bin=""
  if [ "$is_agent" -eq 1 ]; then
    if ! git -C "$workdir" rev-parse --git-dir >/dev/null 2>&1; then
      [ "$dirty_only" -eq 1 ] && die "add: not a git repository: $workdir (--dirty-only requires git)"
      echo "octask: warning: $workdir is not a git repository" >&2
    fi
    if [ "$dirty_only" -eq 1 ]; then
      command -v git >/dev/null 2>&1 || die "add: git not found (--dirty-only requires it)"
    fi
    # prefer the v2 beta — the service DB is migrated by it; older builds
    # fail with "no such column: project_id"
    if [ -x "${HOME}/.opencode/bin/opencode2" ]; then
      oc_bin="$HOME/.opencode/bin/opencode2"
    else
      oc_bin="$(command -v opencode || true)"
      [ -n "$oc_bin" ] || die "add: no opencode binary found"
    fi
    echo "binary: $oc_bin"
    local agent_found=0 f
    for f in "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/agents/$agent_id.md" \
             "$workdir/.opencode/agents/$agent_id.md"; do
      [ -f "$f" ] && { agent_found=1; echo "agent def: $f"; break; }
    done
    if [ "$agent_found" -eq 0 ]; then
      echo "octask: WARNING: no agent definition found for '$agent_id'" >&2
      echo "  (checked ~/.config/opencode/agents/ and $workdir/.opencode/agents/)" >&2
      echo "  the run will fail until the agent exists — create it before enabling" >&2
    fi
  fi

  # ---- build the run command ------------------------------------------
  if [ "$is_agent" -eq 1 ]; then
    if [ -n "$model" ]; then
      exec_cmd="$oc_bin run --model $model --agent $agent_id $(bq "$prompt")"
    else
      exec_cmd="$oc_bin run --agent $agent_id $(bq "$prompt")"
    fi
    if [ "$dirty_only" -eq 1 ]; then
      exec_cmd="if [ -z \"\$(git status --porcelain)\" ]; then exit 0; fi; exec $exec_cmd"
    fi
    [ -n "$timeout" ] || timeout=600
    envs+=("PATH=/usr/local/bin:/usr/bin")
    [ -n "$description" ] || description="agent $agent_id in ${workdir/#$HOME/~}"
    if [ -n "$model" ]; then
      description="$description [$model]"
    fi
  else
    if [ -n "$model" ]; then
      echo "octask: warning: --model is ignored for --exec tasks" >&2
    fi
    [ -n "$description" ] || description="$exec_cmd"
  fi

  # ---- refuse to clobber ------------------------------------------------
  local base="$UNIT_DIR/$PREFIX$name"
  local f
  for f in "$base.service" "$base.timer"; do
    if [ -e "$f" ] && [ "$force" -ne 1 ]; then
      die "add: $f already exists (use --force to overwrite)"
    fi
  done

  # ---- write units -------------------------------------------------------
  mkdir -p "$UNIT_DIR"
  {
    echo "[Unit]"
    echo "Description=$description"
    echo ""
    echo "[Service]"
    echo "Type=oneshot"
    [ -n "$workdir" ] && echo "WorkingDirectory=$workdir"
    local e
    for e in "${envs[@]+"${envs[@]}"}"; do echo "Environment=$e"; done
    for e in "${creds[@]+"${creds[@]}"}"; do echo "LoadCredential=$e"; done
    [ -n "$timeout" ] && echo "TimeoutStartSec=$timeout"
    echo "ExecStart=/usr/bin/bash -c $(sq "$exec_cmd")"
  } > "$base.service"
  {
    echo "[Unit]"
    echo "Description=$description (timer)"
    echo ""
    echo "[Timer]"
    echo "OnCalendar=$oncalendar"
    [ -n "$delay" ] && echo "RandomizedDelaySec=$delay"
    [ "$persistent" -eq 1 ] && echo "Persistent=true"
    echo ""
    echo "[Install]"
    echo "WantedBy=timers.target"
  } > "$base.timer"

  systemctl --user daemon-reload

  # ---- self-check the generated units ------------------------------------
  local verify_out
  if ! verify_out="$(systemd-analyze verify "$base.service" "$base.timer" 2>&1)"; then
    printf '%s\n' "$verify_out" >&2
    die "add: generated units failed systemd-analyze verify (removed); check quoting of --exec/--prompt"
  fi

  if [ "$no_enable" -eq 1 ]; then
    echo "added $PREFIX$name (not enabled): $base.{service,timer}"
    echo "enable later: octask enable $name"
    return 0
  fi

  systemctl --user enable --now "$PREFIX$name.timer" >/dev/null
  local next
  next="$(systemctl --user show "$PREFIX$name.timer" --property=NextElapseUSecRealtime --value 2>/dev/null)"
  echo "added $PREFIX$name: $base.{service,timer}"
  echo "  schedule: OnCalendar=$oncalendar${delay:+ (delay up to $delay)}$([ "$persistent" -eq 1 ] && echo -n ', persistent')"
  [ -n "$workdir" ] && echo "  workdir:  $workdir"
  echo "  next run: ${next:-unknown} (octask list)"
}

# ------------------------------------------------------------- remove ----
cmd_remove() {
  local dry_run=0 name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*)        die "remove: unknown option: $1" ;;
      *)         [ -z "$name" ] || die "remove: unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  name="$(norm_name "$name")"
  require_name "$name"

  local base="$UNIT_DIR/$PREFIX$name"
  local -a units=("$base.timer" "$base.service")
  local found=0 f
  for f in "${units[@]}"; do [ -e "$f" ] && found=1; done

  if [ "$found" -eq 0 ]; then
    echo "octask: no units found for '$PREFIX$name' (nothing to do)"
    return 0
  fi

  if [ "$dry_run" -eq 1 ]; then
    echo "dry-run: would stop+disable $PREFIX$name.timer, delete:"
    for f in "${units[@]}"; do [ -e "$f" ] && echo "  $f"; done
    return 0
  fi

  systemctl --user stop "$PREFIX$name.timer" 2>/dev/null || true
  systemctl --user disable "$PREFIX$name.timer" 2>/dev/null || true
  for f in "${units[@]}"; do [ -e "$f" ] && rm -f "$f"; done
  systemctl --user daemon-reload
  systemctl --user reset-failed "$PREFIX$name.timer" "$PREFIX$name.service" 2>/dev/null || true
  echo "removed $PREFIX$name ({timer,service})"
}

# ---------------------------------------------------------------- list ----
cmd_list() {
  echo "== managed timers ($PREFIX*) =="
  systemctl --user list-timers "$PREFIX*" --all --no-pager 2>/dev/null || true

  echo ""
  echo "== managed tasks =="
  local found=0 f base tag workdir desc name wd_short
  for f in "$UNIT_DIR"/"$PREFIX"*".timer"; do
    [ -e "$f" ] || continue
    found=1
    base="${f%.timer}"
    name="$(basename "$base")"; name="${name#"$PREFIX"}"
    if grep -q -- '--agent' "$base.service" 2>/dev/null; then tag="agent"; else tag="task"; fi
    workdir="$(sed -n 's/^WorkingDirectory=//p' "$base.service" 2>/dev/null)"
    desc="$(sed -n 's/^Description=//p' "$base.service" 2>/dev/null)"
    desc="${desc/#"$PREFIX$name": /}"   # drop legacy "octask-<name>: " prefix
    desc="${desc//$HOME/\~}"            # ~-abbreviate for display
    [ ${#desc} -gt 88 ] && desc="${desc:0:87}…"
    wd_short="${workdir/#$HOME/\~}"     # \~ survives; plain ~ expands to $HOME
    case " $desc " in *" $wd_short "*) wd_short="" ;; esac
    printf '  [%s] %s — %s%s\n' "$tag" "$name" "${desc:-(no description)}" "${wd_short:+  ($wd_short)}"
  done
  if [ "$found" -eq 0 ]; then
    echo "  (none — nothing managed by octask yet)"
  fi
}

# -------------------------------------------------------------- enable ----
cmd_enable() {
  [ $# -eq 1 ] || { usage; die "enable: exactly one <name> required"; }
  local name; name="$(norm_name "$1")"
  require_name "$name"
  units_exist "$name" || die "enable: no units found for '$PREFIX$name' (octask list)"
  systemctl --user daemon-reload
  systemctl --user enable --now "$PREFIX$name.timer"
  local next
  next="$(systemctl --user show "$PREFIX$name.timer" --property=NextElapseUSecRealtime --value 2>/dev/null)"
  echo "enabled $PREFIX$name.timer — next run: ${next:-unknown}"
}

# ------------------------------------------------------------- disable ----
cmd_disable() {
  [ $# -eq 1 ] || { usage; die "disable: exactly one <name> required"; }
  local name; name="$(norm_name "$1")"
  require_name "$name"
  units_exist "$name" || die "disable: no units found for '$PREFIX$name' (octask list)"
  systemctl --user disable --now "$PREFIX$name.timer"
  echo "disabled $PREFIX$name.timer (units kept — re-enable with: octask enable $name)"
}

# -------------------------------------------------------------- status ----
cmd_status() {
  [ $# -eq 1 ] || { usage; die "status: exactly one <name> required"; }
  local name; name="$(norm_name "$1")"
  require_name "$name"
  systemctl --user status "$PREFIX$name.timer" "$PREFIX$name.service" --no-pager
}

# ---------------------------------------------------------------- logs ----
cmd_logs() {
  local name="" lines=50
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) lines="$2"; shift 2 ;;
      -*) die "logs: unknown option: $1" ;;
      *)  [ -z "$name" ] || die "logs: unexpected argument: $1"; name="$1"; shift ;;
    esac
  done
  name="$(norm_name "$name")"
  require_name "$name"
  journalctl --user -u "$PREFIX$name.service" -n "$lines" --no-pager
}

# Load a task's units into cur_* globals. Dies if a unit is missing or
# unparsable. Agent detection uses the same `--agent` heuristic as list.
load_task() {
  cur_is_agent=0 cur_agent="" cur_model="" cur_prompt="" cur_dirty=0
  cur_workdir="" cur_timeout="" cur_oncalendar="" cur_delay=""
  cur_persistent=0 cur_description="" cur_exec=""
  cur_envs=() cur_creds=()

  local name="$1" base="$UNIT_DIR/$PREFIX$1"
  [ -e "$base.service" ] || die "edit: no service unit for '$PREFIX$1' (octask list)"
  [ -e "$base.timer" ] || die "edit: no timer unit for '$PREFIX$1' (re-add the task)"

  cur_description="$(sed -n 's/^Description=//p' "$base.service" | head -n 1)"
  cur_workdir="$(sed -n 's/^WorkingDirectory=//p' "$base.service" | head -n 1)"
  cur_timeout="$(sed -n 's/^TimeoutStartSec=//p' "$base.service" | head -n 1)"
  local line
  while IFS= read -r line; do cur_envs+=("$line"); done < <(sed -n 's/^Environment=//p' "$base.service")
  while IFS= read -r line; do cur_creds+=("$line"); done < <(sed -n 's/^LoadCredential=//p' "$base.service")

  local execstart outer inner
  execstart="$(sed -n 's/^ExecStart=//p' "$base.service" | head -n 1)"
  [ -n "$execstart" ] || die "edit: $base.service has no ExecStart (re-add the task)"
  case "$execstart" in "/usr/bin/bash -c '"*) ;;
    *) die "edit: unexpected ExecStart format (re-add the task)" ;;
  esac
  outer="${execstart#/usr/bin/bash -c }"
  inner="${outer#\'}"
  inner="${inner%\'}"
  # ponytail: manual sq-decode; eval on a unit file would execute it
  inner="$(printf '%s' "$inner" | sed "s/'\\\\''/'/g")"

  case "$inner" in
    *" run --agent "*|*" run --model "*) cur_is_agent=1 ;;
  esac

  if [ "$cur_is_agent" -eq 1 ]; then
    local dirty_prefix='if [ -z "$(git status --porcelain)" ]; then exit 0; fi; exec '
    case "$inner" in
      "$dirty_prefix"*) cur_dirty=1; inner="${inner#"$dirty_prefix"}" ;;
    esac
    case "$inner" in
      *" --model "*) cur_model="$(printf '%s' "$inner" | sed -n 's/.* --model \([^ ][^ ]*\).*/\1/p')" ;;
    esac
    cur_agent="$(printf '%s' "$inner" | sed -n 's/.* --agent \([^ ][^ ]*\).*/\1/p')"
    [ -n "$cur_agent" ] || die "edit: could not parse --agent (re-add the task)"
    local tmp="${inner#*\"}"
    [ "$tmp" != "$inner" ] || die "edit: could not parse prompt (re-add the task)"
    tmp="${tmp%\"*}"
    cur_prompt="$(unbq "$tmp")"
  else
    cur_exec="$inner"
  fi

  cur_oncalendar="$(sed -n 's/^OnCalendar=//p' "$base.timer" | head -n 1)"
  [ -n "$cur_oncalendar" ] || die "edit: $base.timer has no OnCalendar (re-add the task)"
  cur_delay="$(sed -n 's/^RandomizedDelaySec=//p' "$base.timer" | head -n 1)"
  if grep -q '^Persistent=true' "$base.timer" 2>/dev/null; then cur_persistent=1; fi
}

# ---------------------------------------------------------------- show ----
cmd_show() {
  [ $# -eq 1 ] || { usage; die "show: exactly one <name> required"; }
  local name; name="$(norm_name "$1")"
  require_name "$name"
  units_exist "$name" || die "show: no units found for '$PREFIX$name' (octask list)"
  load_task "$name"
  if [ "$cur_is_agent" -eq 1 ]; then
    echo "task: $name (agent)"
    echo "agent: $cur_agent"
    echo "model: ${cur_model:-(default)}"
    printf 'prompt: %s\n' "$cur_prompt"
  else
    echo "task: $name (exec)"
    printf 'exec: %s\n' "$cur_exec"
  fi
  [ -n "$cur_workdir" ] && echo "workdir: $cur_workdir"
  echo "oncalendar: $cur_oncalendar"
  [ -n "$cur_delay" ] && echo "delay: $cur_delay"
  echo "persistent: $cur_persistent"
  [ -n "$cur_timeout" ] && echo "timeout: $cur_timeout"
  [ "$cur_dirty" -eq 1 ] && echo "dirty-only: 1"
  echo "description: $cur_description"
  local e
  for e in ${cur_envs[@]+"${cur_envs[@]}"}; do echo "env: $e"; done
  for e in ${cur_creds[@]+"${cur_creds[@]}"}; do echo "credential: $e"; done
  local next
  next="$(systemctl --user show "$PREFIX$name.timer" --property=NextElapseUSecRealtime --value 2>/dev/null)" || true
  [ -n "$next" ] && echo "next run: $next"
}

# ---------------------------------------------------------------- edit ----
cmd_edit() {
  local name="" o_model="" o_model_set=0 o_no_model=0 o_prompt="" o_agent=""
  local o_oncalendar="" o_description="" o_desc_set=0 o_workdir="" o_timeout=""
  local o_delay="" o_delay_changed=0 o_persist=-1 dry_run=0
  local -a o_creds=()
  local o_clear_creds=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --model)         o_model="$2"; o_model_set=1; shift 2 ;;
      --no-model)      o_no_model=1; shift ;;
      --prompt)        o_prompt="$2"; shift 2 ;;
      --agent)         o_agent="$2"; shift 2 ;;
      --oncalendar)    o_oncalendar="$2"; shift 2 ;;
      --description)   o_description="$2"; o_desc_set=1; shift 2 ;;
      --workdir)       o_workdir="$2"; shift 2 ;;
      --timeout)       o_timeout="$2"; shift 2 ;;
      --delay)         o_delay="$2"; o_delay_changed=1; shift 2 ;;
      --no-delay)      o_delay=""; o_delay_changed=1; shift ;;
      --persistent)    o_persist=1; shift ;;
      --no-persistent) o_persist=0; shift ;;
      --credential)    o_creds+=("$2"); shift 2 ;;
      --clear-credentials) o_clear_creds=1; shift ;;
      --dry-run)       dry_run=1; shift ;;
      -h|--help)       usage; exit 0 ;;
      -*)              die "edit: unknown option: $1" ;;
      *)               [ -z "$name" ] || die "edit: unexpected argument: $1"; name="$1"; shift ;;
    esac
  done

  [ "$o_model_set" -eq 0 ] || [ "$o_no_model" -eq 0 ] || die "edit: --model and --no-model conflict"
  name="$(norm_name "${name:-}")"
  require_name "$name"
  units_exist "$name" || die "edit: no units found for '$PREFIX$name' (octask list)"
  load_task "$name"

  if [ "$cur_is_agent" -eq 0 ]; then
    { [ -z "$o_prompt" ] && [ -z "$o_agent" ] && [ "$o_model_set" -eq 0 ] && [ "$o_no_model" -eq 0 ]; } \
      || die "edit: --prompt/--agent/--model apply only to agent tasks ('$name' is an --exec task)"
  fi

  # ---- merge overrides onto current values -------------------------------
  local new_agent="${o_agent:-$cur_agent}" new_prompt="${o_prompt:-$cur_prompt}"
  local new_workdir="${o_workdir:-$cur_workdir}" new_oncalendar="${o_oncalendar:-$cur_oncalendar}"
  local new_timeout="${o_timeout:-$cur_timeout}" new_model="$cur_model"
  [ "$o_model_set" -eq 1 ] && new_model="$o_model"
  [ "$o_no_model" -eq 1 ] && new_model=""
  local new_delay="$cur_delay"
  [ "$o_delay_changed" -eq 1 ] && new_delay="$o_delay"
  local new_persist="$cur_persistent"
  [ "$o_persist" -ge 0 ] && new_persist="$o_persist"

  # Description handed to add (which appends [model] itself): strip the old
  # suffix, or drop it entirely when it was auto-generated so add rebuilds it
  # from the new agent/workdir.
  local desc_arg=""
  if [ "$o_desc_set" -eq 1 ]; then
    desc_arg="$o_description"
  elif [ "$cur_is_agent" -eq 1 ]; then
    local base="$cur_description" suffix=""
    [ -n "$cur_model" ] && suffix=" [$cur_model]"
    if [ -n "$suffix" ]; then
      case "$base" in *"$suffix") base="${base%"$suffix"}" ;; esac
    fi
    local auto="agent $cur_agent in ${cur_workdir/#$HOME/~}"
    if [ "$base" = "$auto" ]; then
      desc_arg=""
    else
      desc_arg="$base"
    fi
  else
    desc_arg="$cur_description"
  fi

  # Envs: keep custom ones; add re-adds its PATH line for agent tasks.
  local -a keep_envs=()
  local keep
  for keep in ${cur_envs[@]+"${cur_envs[@]}"}; do
    if [ "$keep" = "PATH=/usr/local/bin:/usr/bin" ] && [ "$cur_is_agent" -eq 1 ]; then
      continue
    fi
    keep_envs+=("$keep")
  done

  # Enabled state: add always enables, so remember to preserve a disabled timer.
  local was_enabled=0
  if systemctl --user is-enabled "$PREFIX$name.timer" >/dev/null 2>&1; then was_enabled=1; fi

  local -a add_args=("$name" --force)
  if [ "$cur_is_agent" -eq 1 ]; then
    add_args+=(--agent "$new_agent" --prompt "$new_prompt" --workdir "$new_workdir")
    [ -n "$new_model" ] && add_args+=(--model "$new_model")
    [ "$cur_dirty" -eq 1 ] && add_args+=(--dirty-only)
  else
    add_args+=(--exec "$cur_exec")
    [ -n "$new_workdir" ] && add_args+=(--workdir "$new_workdir")
  fi
  [ -n "$desc_arg" ] && add_args+=(--description "$desc_arg")
  add_args+=(--oncalendar "$new_oncalendar")
  [ -n "$new_timeout" ] && add_args+=(--timeout "$new_timeout")
  [ -n "$new_delay" ] && add_args+=(--delay "$new_delay")
  [ "$new_persist" -eq 1 ] && add_args+=(--persistent)
  for keep in ${keep_envs[@]+"${keep_envs[@]}"}; do add_args+=(--env "$keep"); done
  # Credentials: keep existing unless cleared, append new ones (same name wins).
  local -a keep_creds=()
  if [ "$o_clear_creds" -eq 0 ]; then
    keep_creds=(${cur_creds[@]+"${cur_creds[@]}"})
  fi
  local nc
  for nc in ${o_creds[@]+"${o_creds[@]}"}; do
    local nn="${nc%%:*}" i
    for i in ${!keep_creds[@]}; do
      [ "${keep_creds[$i]%%:*}" = "$nn" ] && unset 'keep_creds[$i]'
    done
    keep_creds+=("$nc")
  done
  for keep in ${keep_creds[@]+"${keep_creds[@]}"}; do add_args+=(--credential "$keep"); done
  [ "$was_enabled" -eq 0 ] && add_args+=(--no-enable)

  if [ "$dry_run" -eq 1 ]; then
    local real_dir="$UNIT_DIR" tmpdir
    mkdir -p /tmp/opencode
    tmpdir="$(mktemp -d /tmp/opencode/octask-edit.XXXXXX)"
    # shellcheck disable=SC2064  # $tmpdir is set; trap must capture it now
    trap "rm -rf '$tmpdir'" EXIT
    UNIT_DIR="$tmpdir"
    # NOTE: add still runs daemon-reload + verify; reload is a no-op here and
    # verify usefully checks the merged units before the diff.
    cmd_add "${add_args[@]}" --no-enable >/dev/null
    UNIT_DIR="$real_dir"
    diff -u "$real_dir/$PREFIX$name.service" "$tmpdir/$PREFIX$name.service" || true
    diff -u "$real_dir/$PREFIX$name.timer" "$tmpdir/$PREFIX$name.timer" || true
    rm -rf "$tmpdir"
    trap - EXIT
    echo "dry-run: no changes written"
    return 0
  fi

  cmd_add "${add_args[@]}"
  echo "edited $PREFIX$name"
}

# Wrap one-compact-JSON-per-line ($1) into the export document on stdout.
wrap_tasks() {
  python3 - "$1" <<'EOF'
import json, sys
tasks = [json.loads(l) for l in open(sys.argv[1]) if l.strip()]
json.dump({"version": 1, "tasks": tasks}, sys.stdout, indent=2)
sys.stdout.write("\n")
EOF
}

# -------------------------------------------------------------- export ----
# JSON backup of one, several, or all tasks (no names = all) to stdout or
# --file. Import replays the values through cmd_add, so add stays the only
# writer of unit files.
cmd_export() {
  local file=""
  local -a names=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --file) file="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      -*) die "export: unknown option: $1" ;;
      *) names+=("$1"); shift ;;
    esac
  done

  if [ "${#names[@]}" -eq 0 ]; then
    local f n
    for f in "$UNIT_DIR"/"$PREFIX"*".timer"; do
      [ -e "$f" ] || continue
      n="$(basename "$f")"; n="${n#"$PREFIX"}"; n="${n%.timer}"
      names+=("$n")
    done
  fi
  [ "${#names[@]}" -gt 0 ] || die "export: no tasks found (octask list)"

  mkdir -p /tmp/opencode
  local lines
  lines="$(mktemp /tmp/opencode/octask-export.XXXXXX)"
  # shellcheck disable=SC2064  # $lines is set; trap must capture it now
  trap "rm -f '$lines'" EXIT

  local seen=() n name enabled type env_blob="" cred_blob=""
  for n in "${names[@]}"; do
    name="$(norm_name "$n")"
    require_name "$name"
    case " ${seen[*]} " in *" $name "*) continue ;; esac
    seen+=("$name")
    units_exist "$name" || die "export: no units found for '$PREFIX$name' (octask list)"
    load_task "$name"
    enabled=0
    if systemctl --user is-enabled "$PREFIX$name.timer" >/dev/null 2>&1; then enabled=1; fi
    if [ "$cur_is_agent" -eq 1 ]; then type="agent"; else type="exec"; fi
    env_blob=""; cred_blob=""
    [ "${#cur_envs[@]}" -gt 0 ] && env_blob="$(printf '%s\n' "${cur_envs[@]}")"
    [ "${#cur_creds[@]}" -gt 0 ] && cred_blob="$(printf '%s\n' "${cur_creds[@]}")"
    OCTASK_ENVS="$env_blob" OCTASK_CREDS="$cred_blob" \
    python3 - "$name" "$type" "$cur_agent" "$cur_model" "$cur_prompt" \
      "$cur_exec" "$cur_workdir" "$cur_oncalendar" "$cur_delay" \
      "$cur_persistent" "$cur_timeout" "$cur_description" \
      "$cur_dirty" "$enabled" >>"$lines" <<'EOF'
import json, os, sys
(name, type_, agent, model, prompt, exec_, workdir, oncal, delay,
 persist, timeout, desc, dirty, enabled) = sys.argv[1:15]
def rows(key):
    v = os.environ.get(key, "")
    return v.split("\n") if v else []
print(json.dumps({
    "name": name, "type": type_,
    "agent": agent, "model": model, "prompt": prompt, "dirty_only": dirty == "1",
    "exec": exec_, "workdir": workdir, "oncalendar": oncal, "delay": delay,
    "persistent": persist == "1", "timeout": timeout, "description": desc,
    "env": rows("OCTASK_ENVS"), "credentials": rows("OCTASK_CREDS"),
    "enabled": enabled == "1",
}, sort_keys=True))
EOF
  done

  if [ -n "$file" ]; then
    wrap_tasks "$lines" >"$file"
    echo "exported ${#seen[@]} task(s) -> $file"
  else
    wrap_tasks "$lines"
  fi
  rm -f "$lines"
  trap - EXIT
}

# Replay one exported task (compact JSON in $1) through cmd_add ($2=force,
# $3=no_enable).
import_one() {
  local line="$1" force="$2" no_enable="$3"
  local -a f=()
  mapfile -d '' -t f < <(python3 - "$line" <<'EOF'
import json, sys
t = json.loads(sys.argv[1])
def s(k):
    v = t.get(k)
    return "" if v is None else str(v)
def b(k):
    return "1" if t.get(k) else ""
out = [s("name"), s("type") or "exec", s("agent"), s("model"), s("prompt"),
       s("exec"), s("workdir"), s("oncalendar"), s("delay"), b("persistent"),
       s("timeout"), s("description"), b("dirty_only"), b("enabled")]
sys.stdout.write("\0".join(out) + "\0")
for k in ("env", "credentials"):
    vals = t.get(k) or []
    isinstance(vals, list) or sys.exit("import: '%s' must be a list" % k)
    sys.stdout.write(str(len(vals)) + "\0")
    for v in vals:
        sys.stdout.write(str(v) + "\0")
EOF
)
  local name="${f[0]}" type="${f[1]}" agent="${f[2]}" model="${f[3]}"
  local prompt="${f[4]}" exec_cmd="${f[5]}" workdir="${f[6]}"
  local oncalendar="${f[7]}" delay="${f[8]}" persist="${f[9]}"
  local timeout="${f[10]}" desc="${f[11]}" dirty="${f[12]}" enabled="${f[13]}"
  local idx=14
  local nenv="${f[$idx]}" i e
  local -a envs=()
  for ((i = 0; i < nenv; i++)); do envs+=("${f[$((idx + 1 + i))]}"); done
  idx=$((idx + 1 + nenv))
  local ncred="${f[$idx]}"
  local -a creds=()
  for ((i = 0; i < ncred; i++)); do creds+=("${f[$((idx + 1 + i))]}"); done

  name="$(norm_name "$name")"
  local -a add_args=("$name")
  [ "$force" -eq 1 ] && add_args+=(--force)
  if [ "$type" = "agent" ]; then
    add_args+=(--agent "$agent" --prompt "$prompt" --workdir "$workdir")
    [ -n "$model" ] && add_args+=(--model "$model")
    [ "$dirty" = "1" ] && add_args+=(--dirty-only)
  else
    [ "$type" = "exec" ] || die "import: task '$name' has unknown type '$type'"
    add_args+=(--exec "$exec_cmd")
    [ -n "$workdir" ] && add_args+=(--workdir "$workdir")
  fi
  # Description handed to add (which appends [model] itself): strip the old
  # suffix the same way edit does, so the round-trip is exact.
  if [ "$type" = "agent" ] && [ -n "$model" ]; then
    case "$desc" in *" [$model]") desc="${desc%" [$model]"}" ;; esac
  fi
  [ -n "$desc" ] && add_args+=(--description "$desc")
  [ -n "$oncalendar" ] && add_args+=(--oncalendar "$oncalendar")
  [ -n "$timeout" ] && add_args+=(--timeout "$timeout")
  [ -n "$delay" ] && add_args+=(--delay "$delay")
  [ "$persist" = "1" ] && add_args+=(--persistent)
  # Envs: add re-adds its PATH line for agent tasks.
  for e in ${envs[@]+"${envs[@]}"}; do
    if [ "$e" = "PATH=/usr/local/bin:/usr/bin" ] && [ "$type" = "agent" ]; then
      continue
    fi
    add_args+=(--env "$e")
  done
  for e in ${creds[@]+"${creds[@]}"}; do add_args+=(--credential "$e"); done
  if [ "$no_enable" -eq 1 ] || [ "$enabled" != "1" ]; then
    add_args+=(--no-enable)
  fi
  cmd_add "${add_args[@]}"
}

# --------------------------------------------------------------- import ----
# Recreate tasks from `octask export` JSON (--file or stdin). Refuses to
# overwrite without --force; preserves the exported enabled state unless
# --no-enable is given.
cmd_import() {
  local file="" force=0 no_enable=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --file) file="$2"; shift 2 ;;
      --force) force=1; shift ;;
      --no-enable) no_enable=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) die "import: unknown option: $1" ;;
      *) die "import: unexpected argument: $1 (tasks come from --file or stdin)" ;;
    esac
  done

  local src="$file" raw=""
  if [ -z "$src" ]; then
    [ -t 0 ] && { usage; die "import: no --file and stdin is a terminal (pipe JSON or pass --file)"; }
    # Slurp stdin first: python below reads its script from stdin, so
    # /dev/stdin would give it the script instead of the JSON.
    raw="$(mktemp /tmp/opencode/octask-import-raw.XXXXXX)"
    cat >"$raw"
    src="$raw"
  fi
  [ -e "$src" ] || die "import: file not found: $src"

  mkdir -p /tmp/opencode
  local tasks
  tasks="$(mktemp /tmp/opencode/octask-import.XXXXXX)"
  # shellcheck disable=SC2064  # $tasks/$raw are set; trap must capture them now
  trap "rm -f '$tasks' ${raw:+"'$raw'"}" EXIT
  python3 - "$src" >"$tasks" <<'EOF' || die "import: invalid JSON in '$src'"
import json, sys
doc = json.load(open(sys.argv[1]))
tasks = doc.get("tasks", doc) if isinstance(doc, dict) else doc
isinstance(tasks, list) or sys.exit("import: expected {\"version\": 1, \"tasks\": [...]}")
for t in tasks:
    (isinstance(t, dict) and t.get("name")) or sys.exit("import: every task needs a name")
    print(json.dumps(t))
EOF
  [ -s "$tasks" ] || die "import: no tasks in '$src'"

  # Refuse to clobber before writing anything.
  local line iname
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    iname="$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("name",""))' "$line")"
    iname="$(norm_name "$iname")"
    require_name "$iname"
    if units_exist "$iname" && [ "$force" -ne 1 ]; then
      die "import: $UNIT_DIR/$PREFIX$iname.service already exists (use --force to overwrite)"
    fi
  done <"$tasks"

  local count=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    import_one "$line" "$force" "$no_enable"
    count=$((count + 1))
  done <"$tasks"
  rm -f "$tasks"
  [ -n "$raw" ] && rm -f "$raw"
  trap - EXIT
  echo "imported $count task(s)"
}

# -------------------------------------------------------------- dispatcher
cmd="${1:-}"
[ -n "$cmd" ] || { usage; exit 1; }
shift

case "$cmd" in
  add)     cmd_add "$@" ;;
  edit)    cmd_edit "$@" ;;
  show)    cmd_show "$@" ;;
  remove)  cmd_remove "$@" ;;
  list)    cmd_list "$@" ;;
  export)  cmd_export "$@" ;;
  import)  cmd_import "$@" ;;
  enable)  cmd_enable "$@" ;;
  disable) cmd_disable "$@" ;;
  status)  cmd_status "$@" ;;
  logs)    cmd_logs "$@" ;;
  help|-h|--help) usage; exit 0 ;;
  *)       usage; die "unknown subcommand: $cmd" ;;
esac
