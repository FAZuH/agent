#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage:"
    echo "  jt create-r <file.ipynb>        Create empty R kernel notebook"
    echo "  jt create-py <file.ipynb>       Create empty Python kernel notebook"
    echo "  jt to-r <file.ipynb>            Convert ipynb -> r:percent"
    echo "  jt to-py <file.ipynb>           Convert ipynb -> py:percent"
    echo "  jt to-ipynb <file.r|file.py>    Convert r/py -> ipynb"
    exit 1
}

[[ $# -lt 2 ]] && usage

CMD=$1
FILE=$2

case "$CMD" in
    create-r)
        echo '{"cells":[],"metadata":{"kernelspec":{"display_name":"R","language":"R","name":"ir"}},"nbformat":4,"nbformat_minor":5}' > "$FILE"
        ;;
    create-py)
        echo '{"cells":[],"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"}},"nbformat":4,"nbformat_minor":5}' > "$FILE"
        ;;
    to-r)
        OUT="${FILE%.ipynb}.r"
        jupytext --to r:percent "$FILE" -o "$OUT"
        ;;
    to-py)
        OUT="${FILE%.ipynb}.py"
        jupytext --to py:percent "$FILE" -o "$OUT"
        ;;
    to-ipynb)
        OUT="${FILE%.*}.ipynb"
        jupytext --to ipynb "$FILE" -o "$OUT"
        ;;
    *)
        usage
        ;;
esac
