#!/usr/bin/env python3
"""Regenerate ~/.config/himalaya/config.toml from ~/.secrets/mail/*.env.

Usage: himalaya-gen-config
Skips test_* accounts. Passwords stay in the env files and are referenced
via password.command, never embedded. Hand edits to config.toml are lost
on regeneration — put per-account tweaks in the env files' send_as key.
"""
import glob
import os

DEST = "{{USER_HOME}}/.config/himalaya/config.toml"
SRC = "{{USER_HOME}}/.secrets/mail"


def main():
    out = [
        "# Generated by himalaya-gen-config from ~/.secrets/mail/*.env",
        "# (test_* excluded). Passwords via command, never embedded.",
        "",
        'mailbox.alias.inbox = "INBOX"',
    ]
    first = True
    for path in sorted(glob.glob(os.path.join(SRC, "mail_*.env"))):
        alias = os.path.basename(path)[len("mail_") : -len(".env")]
        if alias.startswith("test@"):
            continue
        cfg = {}
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip("'\"")
        imap_port = cfg.get("imap_port", "993")
        if imap_port == "993":
            imap_server = f"imaps://{cfg['imap_host']}:{imap_port}"
        else:
            imap_server = f"imap://{cfg['imap_host']}:{imap_port}"
        smtp_port = cfg.get("smtp_port", "465")
        if cfg.get("starttls_smtp", "").lower() == "true":
            smtp_server = f"smtp://{cfg['smtp_host']}:{smtp_port}"
            starttls = "\nsmtp.starttls = true"
        else:
            smtp_server = f"smtps://{cfg['smtp_host']}:{smtp_port}"
            starttls = ""
        email = cfg.get("send_as") or cfg.get("smtp_user") or alias
        pw = (
            lambda key: '"sed -n \'s/^%s=//p\' \'%s\' | tr -d \'\\\\042\\\\012\\\\015\'"'
            % (key, path)
        )
        out.append(f'[accounts."{alias}"]')
        if first:
            out.append("default = true")
            first = False
        out.append(f'email = "{email}"')
        out.append(f'imap.server = "{imap_server}"')
        out.append(f'imap.sasl.login.username = "{cfg["imap_user"]}"')
        out.append(f"imap.sasl.login.password.command = {pw('imap_pass')}")
        out.append(f'smtp.server = "{smtp_server}"' + starttls)
        out.append(f'smtp.sasl.plain.username = "{cfg["smtp_user"]}"')
        out.append(f'smtp.sasl.plain.password.command = {pw("smtp_pass")}')
        out.append("")
    with open(DEST, "w") as f:
        f.write("\n".join(out))
    os.chmod(DEST, 0o600)
    print(f"wrote {DEST}")


if __name__ == "__main__":
    main()
