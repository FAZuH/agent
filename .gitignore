# sync manifest — tracked pushes live here, never commit it
.agent-sync.json

# machine-local values (installer-owned; not used by sync.sh)
.agent-values

# plugin dependencies (plugins/package.json is committed, modules are not)
node_modules/

# agent friction log (machine-local, never tracked)
.papercuts.jsonl

# python bytecode caches
__pycache__/

# Rust build output (the workspace lockfile stays tracked — these are binaries)
/target
/scripts/target
